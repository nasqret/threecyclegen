    B = {⟨0, by unfold N; omega⟩} := by
      -- Assume that 3 is in B. Then, since B is a block, applying g1^2 (which maps 0 to 3 and 3 to 6) would mean that 6 is in B. But 6 is not in {0, 3}, so this leads to a contradiction. Therefore, 3 can't be in B, and B must be {0}.
      by_contra h_contra
      have h3 : ⟨3, by
        exact lt_add_of_lt_of_nonneg ( lt_add_of_lt_of_nonneg ( lt_add_of_lt_of_nonneg ( by decide ) ( Nat.zero_le _ ) ) ( Nat.zero_le _ ) ) ( Nat.zero_le _ )⟩ ∈ B := by
        grind
