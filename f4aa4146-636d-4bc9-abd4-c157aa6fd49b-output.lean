-/
lemma c_3cycle_is_three_cycle (n k m : ℕ) (hn : 1 < n) (hk : 0 < k) (hm : 0 < m) :
    (c_3cycle n k m).IsThreeCycle := by
      -- From `c_3cycle_values`, we have:
      -- c_3cycle 1 = 3.
      -- c_3cycle 3 = 2.
      -- c_3cycle 2 = 1.
