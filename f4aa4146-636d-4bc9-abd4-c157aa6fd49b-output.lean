    have h_g_comm_def : g_comm n k m = g1 n k m * g2 n k m * (g1 n k m)⁻¹ * (g2 n k m)⁻¹ := by
      rfl;
    aesop;
    rw [ g1_inv_zero_val ];
    · rw [ show ( g2 n k m ) ⟨ 6 + n - 1, by
            exact lt_of_lt_of_le ( Nat.sub_lt ( by linarith ) ( by linarith ) ) ( by linarith! [ show N n k m = 6 + n + k + m by rfl ] ) ⟩ = ⟨ 6 + n - 1, by
            exact lt_of_lt_of_le ( Nat.sub_lt ( by linarith ) ( by linarith ) ) ( by linarith! [ show N n k m = 6 + n + k + m by rfl ] ) ⟩ from ?_ ]
      all_goals generalize_proofs at *;
      · exact?;
      · unfold g2;
        unfold l2;
        rw [ List.formPerm_apply_of_not_mem ] ; aesop;
        · linarith;
        · linarith;
        · linarith;
        · linarith;
    · linarith)
lemma g_comm_2 (n k m : ℕ) (hn : 0 < n) (hk : 0 < k) : g_comm n k m ⟨2, by
  exact Nat.lt_of_lt_of_le ( by linarith ) ( Nat.le_add_right _ _ ) |> Nat.lt_of_lt_of_le <| Nat.le_add_right _ _⟩ = ⟨4, by
  -- Since $n$, $k$, and $m$ are all positive, their sum is at least 3. Adding 6 to that gives at least 9, which is definitely greater than 4.
  have hN_gt_4 : 4 < 6 + n + k + m := by
    linarith [hn, hk];
  exact hN_gt_4⟩ := by
  all_goals generalize_proofs at *;
  -- Apply the permutations step by step.
  have h_step : (g2 n k m)⁻¹ ⟨2, by
    linarith⟩ = ⟨2, by
    linarith⟩ ∧ (g1 n k m)⁻¹ ⟨2, by
    linarith⟩ = ⟨3, by
    unfold N at *; linarith;⟩ ∧ (g2 n k m) ⟨3, by
    unfold N at *; linarith;⟩ = ⟨4, by
    assumption⟩ ∧ (g1 n k m) ⟨4, by
    assumption⟩ = ⟨4, by
    assumption⟩ := by
    all_goals generalize_proofs at *;
    -- Apply the lemmas to each part of the conjunction.
    apply And.intro;
    · exact?;
    · exact ⟨ g1_inv_action n k m hn |>.2.1, g2_action n k m hk |>.2.2.1, g1_action n k m hn |>.2.2.2.2.2 ⟩
  generalize_proofs at *;
  -- Apply the permutations step by step using the values from h_step.
  simp [g_comm, h_step]
lemma g_comm_4 (n k m : ℕ) (hn : 0 < n) (hk : 0 < k) : g_comm n k m ⟨4, by
  -- Since $n$, $k$, and $m$ are all positive, their sum is at least 3. Adding 6 to that gives at least 9, which is definitely greater than 4.
  have hN_gt_4 : 4 < 6 + n + k + m := by
    linarith [hn, hk];
  exact hN_gt_4⟩ = ⟨3, by
  -- Since $n$, $k$, and $m$ are positive integers, we have $6 + n + k + m > 3$.
  have h_pos : 6 + n + k + m > 3 := by
    linarith [hn, hk];
  exact h_pos⟩ := by
  all_goals generalize_proofs at *;
  unfold g_comm;
  have := g2_inv_4 n k m hk; have := g1_inv_action n k m hn; have := g2_action n k m hk; have := g2_inv_3 n k m hk; simp_all ( config := { decide := Bool.true } ) ;
  exact g1_action _ _ _ hn |>.2.1
lemma g_comm_3 (n k m : ℕ) (hn : 0 < n) (hk : 0 < k) : g_comm n k m ⟨3, by
  -- Since $n$, $k$, and $m$ are positive integers, we have $6 + n + k + m > 3$.
  have h_pos : 6 + n + k + m > 3 := by
    linarith [hn, hk];
  exact h_pos⟩ = ⟨2, by
  exact Nat.lt_of_lt_of_le ( by linarith ) ( Nat.le_add_right _ _ ) |> Nat.lt_of_lt_of_le <| Nat.le_add_right _ _⟩ := by
  all_goals generalize_proofs at *;
  unfold g_comm; aesop;
  have := g2_inv_3 n k m hk; have := g1_inv_action n k m hn; have := g2_action n k m hk; have := g1_action n k m hn; aesop;

/-
g2 fixes elements >= 6+n+k.
-/
lemma g2_fixes_large (n k m : ℕ) (hk : 0 < k) (x : Fin (N n k m)) (hx : 6 + n + k ≤ x.val) : g2 n k m x = x := by
  unfold g2;
  -- Since $x \geq 6 + n + k$, $x$ is not in the list $l2 n k m$, so the permutation formed by $l2 n k m$ fixes $x$.
  have h_not_in_list : x ∉ l2 n k m := by
    -- Since $x \geq 6 + n + k$, it is not in the first four elements of $l2 n k m$ (which are $0, 1, 3, 4$) and not in the range part (which goes up to $6 + n + k - 1$).
    have h_not_in_first_four : x.val ≠ 0 ∧ x.val ≠ 1 ∧ x.val ≠ 3 ∧ x.val ≠ 4 := by
      grind;
    unfold l2; aesop;
    linarith;
  exact?

/-
Forward action of g1 on interior elements.
-/
lemma g1_interior_forward (n k m : ℕ) (hn : 1 < n) (x : Fin (N n k m)) (hx : 6 ≤ x.val ∧ x.val < 6 + n - 1) :
    g1 n k m x = ⟨x.val + 1, by
      unfold N; omega;⟩ := by
      all_goals generalize_proofs at *;
      unfold g1; aesop;
      -- Since x is in the list l1 n k m, we can apply the hypothesis h_formPerm to x.
      have hx_in_list : x ∈ l1 n k m := by
        unfold l1; aesop;
        exact Or.inr <| Or.inr <| Or.inr <| Or.inr <| ⟨ x - 6, by omega, by erw [ Fin.ext_iff ] ; norm_num; omega ⟩;
      have := List.mem_iff_get.1 hx_in_list; aesop;
      -- Since $w$ is not the last element in the list, we can apply the definition of `formPerm`.
      have h_not_last : w.val < (l1 n k m).length - 1 := by
        unfold l1 at *; aesop;
        rcases w with ⟨ _ | _ | _ | _ | w, hw ⟩ <;> norm_num at * ; linarith;
      rw [ List.formPerm_apply_getElem ];
      · -- Since $w$ is not the last element, adding 1 to $w$ will give the next element in the list.
        have h_next : (l1 n k m)[w.val + 1] = ⟨(l1 n k m)[w.val] + 1, by
          linarith⟩ := by
          unfold l1; aesop;
          rcases w with ⟨ _ | _ | _ | _ | w, hw ⟩ <;> norm_num at *;
          · unfold l1 at * ; aesop;
          · unfold l1 at * ; aesop;
          · unfold l1 at * ; aesop;
          · unfold l1 at * ; aesop;
          · ring
        generalize_proofs at *;
        -- Since $w$ is a Fin, its value is less than the length of the list. So when we add 1 to $w$, it's still within the bounds of the list. Therefore, the modulo operation here is just the identity because the length is greater than $w + 1$. So the equality holds trivially.
        simp [Nat.mod_eq_of_lt (by linarith : (w + 1 : ℕ) < (l1 n k m).length)];
        exact h_next;
      · -- Since $n$ is positive, the list $l1 n k m$ is nodup by definition.
        apply l1_nodup n k m (by linarith)

/-
Value of g1 inverse for interior elements of the range [6, 6+n).
-/
lemma g1_inv_interior (n k m : ℕ) (hn : 1 < n) (x : Fin (N n k m)) (hx : 6 < x.val ∧ x.val < 6 + n) :
    (g1 n k m)⁻¹ x = ⟨x.val - 1, by
      exact lt_of_le_of_lt ( Nat.pred_le _ ) x.2⟩ := by
      -- By definition of the inverse function, if $g1(y) = x$, then $(g1⁻¹)(x) = y$.
      have h_inv : (g1 n k m)⁻¹ (g1 n k m ⟨x.val - 1, by
        exact lt_of_le_of_lt ( Nat.pred_le _ ) x.2⟩) = ⟨x.val - 1, by
        exact lt_of_le_of_lt ( Nat.pred_le _ ) x.2⟩ := by
        simp +zetaDelta at *
      generalize_proofs at *;
      convert h_inv using 2
      generalize_proofs at *;
      rw [ g1_interior_forward ] <;> aesop
      all_goals generalize_proofs at *;
      · exact Eq.symm ( Fin.ext ( Nat.succ_pred_eq_of_pos ( pos_of_gt left ) ) );
      · omega;
      · omega

/-
g2 fixes elements in the range [6, 6+n).
-/
lemma g2_fixes_range_n (n k m : ℕ) (hn : 0 < n) (hk : 0 < k) (x : Fin (N n k m)) (hx : 6 ≤ x.val ∧ x.val < 6 + n) :
    g2 n k m x = x := by
      -- Since $x$ is in the range $[6, 6+n)$, it is not in the support of $g2 n k m$, so $g2 n k m x = x$.
      have h_not_in_support : x.val ∉ ({0, 1, 3, 4} ∪ Finset.Ico (6 + n) (6 + n + k)).image (fun x => x) := by
        -- Since $x.val$ is between $6$ and $6 + n - 1$, it cannot be in the interval $[6 + n, 6 + n + k)$ or in the set $\{0, 1, 3, 4\}$.
        simp [hx, Finset.mem_union, Finset.mem_Ico];
        omega;
      unfold g2 at * ; aesop;
      rw [ List.formPerm_apply_of_notMem ];
      -- Since $x$ is not in the first four elements of $l2$ and not in the range $[6+n, 6+n+k)$, it cannot be in $l2$.
      simp [l2, left, right];
      exact ⟨ ne_of_apply_ne Fin.val left_1, ne_of_apply_ne Fin.val left_2, ne_of_apply_ne Fin.val left_3, ne_of_apply_ne Fin.val right_1, fun i hi => ne_of_apply_ne Fin.val <| by linarith ⟩

/-
Value of g1 inverse at 6.
-/
lemma g1_inv_six (n k m : ℕ) (hn : 0 < n) : (g1 n k m)⁻¹ ⟨6, by
  exact lt_add_of_lt_of_nonneg ( lt_add_of_lt_of_nonneg ( lt_add_of_pos_right _ hn ) ( Nat.zero_le _ ) ) ( Nat.zero_le _ )⟩ = ⟨2, by
  exact lt_add_of_lt_of_nonneg ( lt_add_of_lt_of_nonneg ( lt_add_of_lt_of_nonneg ( by decide ) ( Nat.zero_le _ ) ) ( Nat.zero_le _ ) ) ( Nat.zero_le _ )⟩ := by
  -- Since g1 is a cycle, its inverse is the reverse cycle. Therefore, applying g1⁻¹ to 6 should give 2.
  have h_inv : g1 n k m ⟨2, by
    exact lt_add_of_lt_of_nonneg ( lt_add_of_lt_of_nonneg ( lt_add_of_lt_of_nonneg ( by decide ) ( Nat.zero_le _ ) ) ( Nat.zero_le _ ) ) ( Nat.zero_le _ )⟩ = ⟨6, by
    exact lt_add_of_lt_of_nonneg ( lt_add_of_lt_of_nonneg ( lt_add_of_pos_right _ hn ) ( Nat.zero_le _ ) ) ( Nat.zero_le _ )⟩ := by
    exact?
  generalize_proofs at *;
  exact?

/-
Value of g1 inverse for interior elements of the range [6, 6+n).
-/
lemma g1_inv_interior_val (n k m : ℕ) (hn : 1 < n) (x : Fin (N n k m)) (hx : 6 < x.val ∧ x.val < 6 + n) :
    (g1 n k m)⁻¹ x = ⟨x.val - 1, by
      exact lt_of_le_of_lt ( Nat.sub_le _ _ ) x.2⟩ := by
      exact?

/-
g_comm fixes elements >= 6+n+k.
-/
lemma g_comm_fixes_very_large (n k m : ℕ) (hn : 0 < n) (hk : 0 < k) (hm : 0 < m) (x : Fin (N n k m)) (hx : 6 + n + k ≤ x.val) :
    g_comm n k m x = x := by
      -- Since $x \geq 6 + n + k$, it is not in the support of $g1$ or $g2$, so $g1 x = x$ and $g2 x = x$.
      have h_g1_g2_x : g1 n k m x = x ∧ g2 n k m x = x := by
        -- Since $x \geq 6 + n + k$, it is not in the support of $g1$ or $g2$, so $g1 x = x$ and $g2 x = x$ by definition of support.
        have h_support_g1 : x ∉ (g1 n k m).support := by
          norm_num +zetaDelta at *;
          -- Since $x$ is in the range $[6+n+k, N n k m)$, we know that $g1 x = x$ by the lemma g1_fixes_large.
          apply g1_fixes_large n k m hn hk hm x (by linarith)
        have h_support_g2 : x ∉ (g2 n k m).support := by
          -- Since $x \geq 6 + n + k$, it is not in the support of $g2$, so $g2 x = x$.
          have h_support_g2 : x ∉ (g2 n k m).support := by
            have h_range : ∀ x : Fin (N n k m), 6 + n + k ≤ x.val → g2 n k m x = x := by
              exact?
            aesop;
          assumption;
        exact ⟨ Classical.not_not.1 fun h => h_support_g1 <| by aesop, Classical.not_not.1 fun h => h_support_g2 <| by aesop ⟩;
      -- Since $g1 x = x$ and $g2 x = x$, applying $g1⁻¹$ and $g2⁻¹$ to $x$ also gives $x$.
      have h_g1_inv_g2_inv_x : (g1 n k m)⁻¹ x = x ∧ (g2 n k m)⁻¹ x = x := by
        rw [ Equiv.Perm.inv_eq_iff_eq, Equiv.Perm.inv_eq_iff_eq ] ; aesop;
      unfold g_comm; aesop;

/-
Forward action of g2 on interior elements of the range [6+n, 6+n+k).
-/
lemma g2_interior_forward (n k m : ℕ) (hk : 1 < k) (x : Fin (N n k m)) (hx : 6 + n ≤ x.val ∧ x.val < 6 + n + k - 1) :
    g2 n k m x = ⟨x.val + 1, by
      unfold N; omega;⟩ := by
      all_goals generalize_proofs at *;
      unfold g2; aesop;
      -- Since $x$ is in the range $[6+n, 6+n+k-2]$, we can apply the definition of $l2$ to find its image under the permutation.
      have h_l2 : x ∈ ((List.range k).attach.map (fun ⟨i, hi⟩ => ⟨6 + n + i, by
        unfold N; norm_num at *; omega⟩)) := by
        all_goals generalize_proofs at *;
        simp +zetaDelta at *;
        exact ⟨ x - ( 6 + n ), by omega, by erw [ Fin.ext_iff ] ; simp ( config := { decide := Bool.true } ) [ add_tsub_cancel_of_le left ] ⟩
      generalize_proofs at *;
      -- Since $x$ is in the list $l2$, there exists some $i$ such that $x$ is the $i$-th element of $l2$.
      obtain ⟨i, hi⟩ : ∃ i : Fin (List.length (l2 n k m)), (l2 n k m).get i = x := by
        rw [ List.mem_iff_get ] at h_l2 ; aesop;
        use ⟨ w + 4, by
          unfold l2; simp +arith +decide; omega; ⟩
        generalize_proofs at *;
        unfold l2; aesop;
      norm_num +zetaDelta at *;
      bound;
      rw [ List.formPerm_apply_getElem ];
      · unfold l2; aesop;
        rcases i with ⟨ _ | _ | _ | _ | i, hi ⟩ <;> norm_num [ Fin.ext_iff, Fin.val_add ] at *;
        · unfold l2 at * ; aesop;
          linarith;
        · rcases k with ( _ | _ | k ) <;> trivial;
        · rcases k with ( _ | _ | k ) <;> norm_num [ List.get ] at *;
          norm_num [ Nat.mod_eq_of_lt ];
          unfold l2 at * ; aesop;
          linarith;
        · rcases k with ( _ | _ | k ) <;> simp_all +arith +decide [ Nat.mod_eq_of_lt ];
          -- Since $(i + 5) \% (k + 6)$ is just $i + 5$ when $i < k + 6$, we can simplify the expression.
          have h_mod : (i + 5) % (k + 6) = i + 5 := by
            rw [ Nat.mod_eq_of_lt ];
            unfold l2 at hi; simp +arith +decide at hi;
            unfold l2 at * ; aesop;
            cases lt_or_eq_of_le hi <;> first | linarith | aesop;
          simp +arith +decide [ h_mod ];
      · exact?

/-
Value of g2 inverse for interior elements of the range [6+n, 6+n+k).
-/
lemma g2_inv_interior (n k m : ℕ) (hk : 1 < k) (x : Fin (N n k m)) (hx : 6 + n < x.val ∧ x.val < 6 + n + k) :
    (g2 n k m)⁻¹ x = ⟨x.val - 1, by
      exact lt_of_le_of_lt ( Nat.pred_le _ ) x.2⟩ := by
      -- Since $g2$ is a permutation, its inverse exists and satisfies $g2^{-1}(x) = x - 1$.
      have h_inv : g2 n k m (⟨x.val - 1, by
        exact lt_of_le_of_lt ( Nat.pred_le _ ) x.2⟩) = x := by
        convert g2_interior_forward n k m hk ⟨ x - 1, by
          exact lt_of_le_of_lt ( Nat.pred_le _ ) x.2 ⟩ ⟨ by
          exact Nat.le_sub_one_of_lt hx.1, by
          exact lt_tsub_iff_right.mpr ( by linarith! [ Nat.sub_add_cancel ( by linarith : 1 ≤ ( x : ℕ ) ) ] ) ⟩ using 1
        generalize_proofs at *;
        exact Eq.symm ( Fin.ext ( Nat.succ_pred_eq_of_pos ( pos_of_gt hx.1 ) ) )
      generalize_proofs at *;
      exact?

#check g2_interior_forward

/-
g_comm fixes elements in the range [6, 6+n).
-/
lemma g_comm_fixes_range_n (n k m : ℕ) (hn : 1 < n) (hk : 0 < k) (hm : 0 < m) (x : Fin (N n k m)) (hx : 6 ≤ x.val ∧ x.val < 6 + n) :
    g_comm n k m x = x := by
      -- Since $x \in [6, 6+n)$, we have $g2 x = x$.
      have h_g2_x : g2 n k m x = x := by
        -- Apply the lemma that states g2 fixes elements in the range [6, 6+n).
        apply g2_fixes_range_n n k m (by linarith) (by linarith) x hx;
      -- Since $g2 x = x$, we have $g_comm x = g1 (g2 (g1⁻¹ x))$.
      have h_g_comm_x : g_comm n k m x = g1 n k m (g2 n k m ((g1 n k m)⁻¹ x)) := by
        -- By definition of g_comm, we have g_comm x = g1 (g2 (g1⁻¹ (g2⁻¹ x))).
        simp [g_comm];
        rw [ Equiv.Perm.inv_eq_iff_eq ] ; aesop;
      by_cases h : x.val = 6 <;> simp_all ( config := { decide := Bool.true } ) [ Equiv.Perm.inv_eq_iff_eq ];
      · -- Substitute the known values of g1⁻¹ 6, g2 2, and g1 2.
        have h_subst : (g1 n k m) ((g2 n k m) ((g1 n k m)⁻¹ x)) = (g1 n k m) ((g2 n k m) ⟨2, by
          grind⟩) := by
          all_goals generalize_proofs at *;
          congr;
          convert g1_inv_six n k m hx;
        all_goals generalize_proofs at *;
        -- Substitute the known value of g1 n k m ⟨2, by sorry⟩.
        have h_g1_two : (g1 n k m) ⟨2, by
          linarith⟩ = ⟨6, by
          -- Since $n$, $k$, and $m$ are all positive integers, adding them to $6$ will definitely make $N n k m$ larger than $6$.
          have h_pos : 0 < n ∧ 0 < k ∧ 0 < m := by
            exact ⟨ hx, hk, hm ⟩;
          exact lt_add_of_lt_of_nonneg ( lt_add_of_lt_of_nonneg ( lt_add_of_pos_right _ h_pos.1 ) ( Nat.zero_le _ ) ) ( Nat.zero_le _ )⟩ := by
          all_goals generalize_proofs at *;
          exact?
        all_goals generalize_proofs at *;
        exact h_subst.trans ( by erw [ show ( g2 n k m ) ⟨ 2, by linarith ⟩ = ⟨ 2, by linarith ⟩ from by { exact g2_two_eq_two n k m hk } ] ; aesop );
      · -- Since $x \in [6, 6+n)$ and $x \neq 6$, we have $(g1 n k m)⁻¹ x = ⟨x.val - 1, by sorry⟩$.
        have h_inv_x : (g1 n k m)⁻¹ x = ⟨x.val - 1, by
          exact lt_of_le_of_lt ( Nat.pred_le _ ) x.2⟩ := by
          all_goals generalize_proofs at *;
          exact g1_inv_interior_val n k m hn x ⟨ lt_of_le_of_ne hx.1 ( Ne.symm h ), hx.2 ⟩
        generalize_proofs at *;
        -- Since $g2 n k m x = x$, we can replace $g2 n k m ((g1 n k m)⁻¹ x)$ with $(g1 n k m)⁻¹ x$.
        have h_g2_inv_x : g2 n k m ((g1 n k m)⁻¹ x) = (g1 n k m)⁻¹ x := by
          convert g2_fixes_range_n n k m ( by linarith ) hk _ _ using 1 ; aesop;
          · omega;
          · omega;
        -- Since $g1$ is a permutation, applying it and then its inverse gives back the original element.
        have h_g1_inv : ∀ x : Fin (N n k m), g1 n k m ((g1 n k m)⁻¹ x) = x := by
          exact fun x => Equiv.Perm.apply_inv_self _ _;
        rw [ h_g2_inv_x, h_g1_inv ]

/-
g_comm fixes elements in the range [6+n, 6+n+k).
-/
lemma g_comm_fixes_range_k (n k m : ℕ) (hn : 0 < n) (hk : 0 < k) (hm : 0 < m) (x : Fin (N n k m)) (hx : 6 + n ≤ x.val ∧ x.val < 6 + n + k) :
    g_comm n k m x = x := by
      unfold g_comm;
      by_cases hx_eq : x.val = 6 + n;
      · -- Apply g1 to x: Since x.val is 6 + n, g1 x = x.
        have h1 : g1 n k m x = x := by
          -- Since $x.val = 6 + n$, and $g1 n k m$ fixes elements at $6 + n$, we have $g1 n k m x = x$.
          apply g1_fixes_large n k m hn hk hm x (by linarith);
        have h2 : g2 n k m (⟨4, by
          exact lt_add_of_lt_of_nonneg ( lt_add_of_lt_of_nonneg ( by linarith ) ( Nat.zero_le _ ) ) ( Nat.zero_le _ )⟩ : Fin (N n k m)) = x := by
          convert g2_boundary n k m hk |>.1;
        have := g1_inv_action n k m hn; aesop;
      · -- Since $x \neq 6 + n$, we have $6 + n < x < 6 + n + k$.
        have hx_lt : 6 + n < x.val ∧ x.val < 6 + n + k := by
          exact ⟨ lt_of_le_of_ne hx.1 ( Ne.symm hx_eq ), hx.2 ⟩;
        have h_g2_inv : (g2 n k m)⁻¹ x = ⟨x.val - 1, by
          exact lt_of_le_of_lt ( Nat.pred_le _ ) x.2⟩ := by
          convert g2_inv_interior n k m ( show 1 < k from _ ) x _ using 1
          all_goals generalize_proofs at *;
          · omega;
          · tauto
        generalize_proofs at *;
        have h_g1_inv : (g1 n k m)⁻¹ ⟨x.val - 1, by
          assumption⟩ = ⟨x.val - 1, by
          assumption⟩ := by
          have h_g1_inv : g1 n k m ⟨x.val - 1, by
            assumption⟩ = ⟨x.val - 1, by
            assumption⟩ := by
            apply_rules [ g1_fixes_large ];
            exact Nat.le_sub_one_of_lt hx_lt.1
          generalize_proofs at *;
