          simp +zetaDelta at *;
          · specialize this 1 ; simp_all +decide [ Set.disjoint_left ];
            tauto;
          · exact fun K hK => K.mul_mem ( hK <| Set.mem_insert _ _ ) ( hK <| Set.mem_insert _ _ );
        simp_all +decide [ Set.disjoint_left ];
        cases' h6 with h6 h6;
        · simp_all +decide [ Set.mem_smul_set ];
          exact False.elim <| h6 _ h0 <| by have := g1_sq_zero n k m hn; aesop;
        · exact h6 ▸ Set.mem_smul_set.mpr ⟨ _, h3, g1_sq_three n k m hn ⟩
      generalize_proofs at *;
      have := h_subset h6; simp_all +decide ;

/-
H is primitive.
-/
open Equiv Equiv.Perm List MulAction

lemma H_primitive (n k m : ℕ) (hn : 0 < n) (hk : 0 < k) (hm : 0 < m) :
    MulAction.IsPreprimitive (H n k m) (Fin (N n k m)) := by
      -- By combining the results from the lemmas, we can conclude that any block containing 0 is either {0} or the entire set.
      have h_block_cases : ∀ B : Set (Fin (N n k m)), MulAction.IsBlock (H n k m) B → (⟨0, by
        -- Since $n$, $k$, and $m$ are positive, their sum plus 6 is also positive.
        simp [N, hn, hk, hm]⟩ ∈ B) → (B = {⟨0, by
        -- Since $n$, $k$, and $m$ are positive, their sum plus 6 is also positive.
        simp [N, hn, hk, hm]⟩} ∨ B = Set.univ) := by
        intros B hB h0
        by_cases h_inter : (g3 n k m).support.toSet ∩ B ≠ ∅;
        · -- Apply the lemma that states if a block containing 0 intersects the support of g3, then the block is the entire set.
          apply Or.inr; exact block_eq_univ_of_inter_support_g3 n k m hn hk hm B hB h0 h_inter;
        · -- Apply the lemma that states if B is a subset of {0, 3} and contains 0, then B must be {0}.
          apply Or.inl; exact block_subset_zero_three_implies_eq_zero n k m hn hk hm B hB h0 (subset_zero_three_of_disjoint_support_g3 n k m hn hk hm B hB h0 (by
          exact Classical.not_not.mp h_inter))
      generalize_proofs at *;
      -- Since H is transitive, any block containing any element x is of the form h • B for some h in H.
      have h_transitive : MulAction.IsPretransitive (H n k m) (Fin (N n k m)) := by
        -- Apply the lemma that states H is transitive.
        apply H_transitive n k m hn hk hm;
      -- By transitivity, for any element x, there exists h in H such that h • 0 = x.
      have h_trans : ∀ x : Fin (N n k m), ∃ h : H n k m, h • ⟨0, by
        exact?⟩ = x := by
        -- By transitivity of H, for any x, there exists h in H such that h • ⟨0, by sorry⟩ = x.
        intros x
        apply h_transitive.exists_smul_eq ⟨0, by
          exact?⟩ x
        skip
      generalize_proofs at *;
      -- By transitivity, for any element x, there exists h in H such that h • 0 = x. If B is a block containing x, then h⁻¹ • B is a block containing 0.
      have h_block_cases_for_all : ∀ x : Fin (N n k m), ∀ B : Set (Fin (N n k m)), MulAction.IsBlock (H n k m) B → x ∈ B → (B = {x} ∨ B = Set.univ) := by
        intros x B hB hx
        obtain ⟨h, hh⟩ := h_trans x
        generalize_proofs at *;
        have h_block_cases_for_all : MulAction.IsBlock (H n k m) (h⁻¹ • B) ∧ (⟨0, by
          exact?⟩ : Fin (N n k m)) ∈ h⁻¹ • B := by
          constructor
          all_goals generalize_proofs at *;
          · exact?;
          · exact ⟨ x, hx, by aesop ⟩
        generalize_proofs at *;
        cases h_block_cases _ h_block_cases_for_all.1 h_block_cases_for_all.2 <;> simp_all +decide [ Set.ext_iff ];
        · left; intro y; specialize ‹∀ x : Fin ( N n k m ), x ∈ h⁻¹ • B ↔ x = ⟨ 0, by linarith ⟩ › ( h⁻¹ • y ) ; simp_all +decide [ Set.mem_smul_set_iff_inv_smul_mem ] ;
          simp +decide [ ← hh, eq_comm ];
          exact?;
        · right; intro y; specialize ‹∀ x : Fin ( N n k m ), x ∈ h⁻¹ • B› ( h⁻¹ • y ) ; aesop;
      constructor;
      intro B hB; specialize h_block_cases_for_all; rcases Set.eq_empty_or_nonempty B with ( rfl | ⟨ x, hx ⟩ ) <;> simp_all +decide [ MulAction.IsTrivialBlock ] ;
      cases h_block_cases_for_all x B hB hx <;> aesop

