open Equiv Equiv.Perm List MulAction

def g_comm (n k m : ℕ) : Perm (Fin (N n k m)) :=
  g1 n k m * g2 n k m * (g1 n k m)⁻¹ * (g2 n k m)⁻¹

def k_comm (n k m : ℕ) : Perm (Fin (N n k m)) :=
  g_comm n k m * g1 n k m * (g_comm n k m)⁻¹ * (g1 n k m)⁻¹

def c_3cycle (n k m : ℕ) : Perm (Fin (N n k m)) :=
  k_comm n k m * k_comm n k m

