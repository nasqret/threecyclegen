/-
Any block containing 0 is either {0} or the universe.
-/
open Equiv Equiv.Perm List MulAction

lemma block_cases_of_zero_mem (n k m : ℕ) (hn : 0 < n) (hk : 0 < k) (hm : 0 < m)
    (B : Set (Fin (N n k m))) (hB : MulAction.IsBlock (H n k m) B) (h0 : ⟨0, by unfold N; omega⟩ ∈ B) :
    B = {⟨0, by unfold N; omega⟩} ∨ B = Set.univ := by
