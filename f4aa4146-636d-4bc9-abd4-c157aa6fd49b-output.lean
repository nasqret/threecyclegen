  -- Since H is generated by g1, g2, and g3, any commutator of elements in H is also in H.
  have h_comm_in_H : ∀ a b : Perm (Fin (N n k m)), a ∈ H n k m → b ∈ H n k m → a * b * a⁻¹ * b⁻¹ ∈ H n k m := by
    exact fun a b ha hb => H n k m |>.mul_mem ( H n k m |>.mul_mem ( H n k m |>.mul_mem ha hb ) ( H n k m |>.inv_mem ha ) ) ( H n k m |>.inv_mem hb ) ;
  exact MulMemClass.mul_mem ( h_comm_in_H _ _ ( h_comm_in_H _ _ ( Subgroup.subset_closure <| Set.mem_insert _ _ ) ( Subgroup.subset_closure <| Set.mem_insert_of_mem _ <| Set.mem_insert _ _ ) ) ( Subgroup.subset_closure <| Set.mem_insert _ _ ) ) ( h_comm_in_H _ _ ( h_comm_in_H _ _ ( Subgroup.subset_closure <| Set.mem_insert _ _ ) ( Subgroup.subset_closure <| Set.mem_insert_of_mem _ <| Set.mem_insert _ _ ) ) ( Subgroup.subset_closure <| Set.mem_insert _ _ ) )


