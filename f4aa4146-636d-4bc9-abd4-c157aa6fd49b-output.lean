      obtain ⟨h_cycle, h_unique⟩ := c_3cycle_values n k m hn hk hm;
      -- To prove that c_3cycle n k m is a 3-cycle, we need to show that it has exactly three elements in its cycle and fixes all others.
      have h_cycle : (c_3cycle n k m).support = {⟨1, by
        grind⟩, ⟨3, by
        exact lt_add_of_lt_of_nonneg ( lt_add_of_lt_of_nonneg ( lt_add_of_lt_of_nonneg ( by decide ) ( by linarith ) ) ( by linarith ) ) ( by linarith )⟩, ⟨2, by
        exact lt_of_lt_of_le ( by decide ) ( add_le_add ( add_le_add ( add_le_add ( Nat.succ_le_succ <| Nat.succ_le_succ <| Nat.succ_le_succ <| Nat.succ_le_succ <| Nat.succ_le_succ <| Nat.succ_le_succ <| Nat.zero_le _ ) hn.le ) hk.le ) hm.le )⟩} := by
        all_goals generalize_proofs at *;
        ext x; by_cases hx : x = ⟨ 1, by linarith ⟩ <;> by_cases hx' : x = ⟨ 3, by linarith ⟩ <;> by_cases hx'' : x = ⟨ 2, by linarith ⟩ <;> aesop;
      generalize_proofs at *;
      bound;
      have h_cycle : (Finset.card (c_3cycle n k m).support = 3) := by
        exact h_cycle.symm ▸ by simp +decide ;
      exact?

/-
H contains the alternating group.
-/
lemma alternatingGroup_le_H (n k m : ℕ) (hn : 1 < n) (hk : 0 < k) (hm : 0 < m) :
    alternatingGroup (Fin (N n k m)) ≤ H n k m := by
      -- By Jordan's theorem, a primitive group containing a 3-cycle contains the alternating group.
      have h_jordan : ∀ {G : Subgroup (Perm (Fin (N n k m)))}, MulAction.IsPreprimitive G (Fin (N n k m)) → (∃ g : Perm (Fin (N n k m)), g ∈ G ∧ g.IsThreeCycle) → alternatingGroup (Fin (N n k m)) ≤ G := by
        norm_num +zetaDelta at *;
        exact?;
      apply h_jordan (by
      -- Apply the lemma that states H n k m is preprimitive.
      apply H_primitive n k m (by linarith) (by linarith) (by linarith)) (by
      exact ⟨ c_3cycle n k m, c_3cycle_in_H n k m, c_3cycle_is_three_cycle n k m hn hk hm ⟩)

/-
H is either the alternating group or the symmetric group.
-/
lemma H_eq_alternating_or_top (n k m : ℕ) (hn : 1 < n) (hk : 0 < k) (hm : 0 < m) :
    H n k m = alternatingGroup (Fin (N n k m)) ∨ H n k m = ⊤ := by
      -- Since the index of the alternating group in the symmetric group is 2, and H n k m contains the alternating group, it must be either the alternating group or the symmetric group.
      have h_index : (alternatingGroup (Fin (N n k m))).index = 2 := by
        -- Apply the theorem that states the index of the alternating group in the symmetric group is 2.
        have h_index : (alternatingGroup (Fin (N n k m))).index = 2 := by
          have h_nontrivial : Nontrivial (Fin (N n k m)) := by
            exact ⟨ ⟨ 0, by linarith [ show N n k m > 0 from by unfold N; linarith ] ⟩, ⟨ 1, by linarith [ show N n k m > 1 from by unfold N; linarith ] ⟩, by simp +decide ⟩
          exact?;
        exact h_index;
      -- Since the index of the alternating group in the symmetric group is 2, and H contains the alternating group, H must be either the alternating group or the symmetric group.
      have h_index : ∀ (H : Subgroup (Equiv.Perm (Fin (N n k m)))), alternatingGroup (Fin (N n k m)) ≤ H → H.index = 1 ∨ H.index = 2 := by
        -- Since the index of the alternating group is 2, and H contains it, the index of H must divide 2.
        intros H hH
        have h_div : H.index ∣ 2 := by
          simpa [ h_index ] using Subgroup.index_dvd_of_le hH;
        rwa [ Nat.dvd_prime Nat.prime_two ] at h_div;
      specialize h_index ( H n k m ) ( alternatingGroup_le_H n k m hn hk hm ) ; aesop;
      exact Or.inl ( by exact? )

/-
Sign of g1.
-/
lemma sign_g1 (n k m : ℕ) (hn : 0 < n) :
    Equiv.Perm.sign (g1 n k m) = (-1 : ℤ) ^ (n + 3) := by
      have := @g1_isCycle n k m hn;
      -- Apply the lemma that states the sign of a cycle of length L is (-1)^(L-1).
      have h_sign_cycle : ∀ {L : ℕ}, 0 < L → ∀ {σ : Equiv.Perm (Fin (N n k m))}, σ.IsCycle → σ.support.card = L → (σ.sign : ℤ) = (-1) ^ (L - 1) := by
        aesop;
        have := a_1.sign;
        rcases x : σ.support.card with ( _ | _ | k ) <;> simp_all +decide [ pow_succ' ];
      -- The length of the list l1 is 4 + n, so the cardinality of its Finset is also 4 + n.
      have h_card_l1 : (l1 n k m).length = n + 4 := by
        unfold l1; simp +arith +decide;
      exact h_sign_cycle ( Nat.succ_pos _ ) this ( by erw [ support_g1_eq _ _ _ hn, List.toFinset_card_of_nodup ( l1_nodup _ _ _ hn ) ] ; linarith )

/-
Sign of g2.
-/
lemma sign_g2 (n k m : ℕ) (hk : 0 < k) :
    Equiv.Perm.sign (g2 n k m) = (-1 : ℤ) ^ (k + 3) := by
      -- Since g2 is a cycle of length k+4, its sign is (-1)^(k+4-1) = (-1)^(k+3).
      have h_cycle_length : (g2 n k m).support.card = k + 4 := by
        rw [ support_g2_eq ];
        · -- The length of the list l2 is 4 + k, and since there are no duplicates, the cardinality of the Finset is also 4 + k.
          have h_length : (l2 n k m).length = 4 + k := by
            unfold l2; simp +arith +decide;
          rw [ add_comm, ← h_length, List.toFinset_card_of_nodup ] ; exact l2_nodup n k m hk;
        · linarith;
      rw [ Equiv.Perm.sign_of_cycleType ];
      -- Since g2 is a cycle, its cycleType is a list with a single element, which is the length of the cycle.
      have h_cycleType : (g2 n k m).cycleType = Multiset.replicate 1 (k + 4) := by
        have h_cycle_type : (g2 n k m).IsCycle := by
          exact?;
        rw [ Equiv.Perm.IsCycle.cycleType ] <;> aesop;
      -- Since the cycleType of g2 is Multiset.replicate 1 (k+4), the sum of the cycle lengths is k+4 and the number of cycles is 1.
      simp [h_cycleType];
      grind

/-
Sign of g3.
-/
lemma sign_g3 (n k m : ℕ) (hm : 0 < m) :
    Equiv.Perm.sign (g3 n k m) = (-1 : ℤ) ^ (m + 3) := by
      have := g3_isCycle n k m hm;
      -- Since g3 is a cycle of length m+4, its sign is (-1)^(m+4-1) = (-1)^(m+3).
      have h_sign_g3 : (g3 n k m).IsCycle → (g3 n k m).support.card = m + 4 := by
        intro h_cycle
        have h_support_card : (g3 n k m).support = (l3 n k m).toFinset := by
          exact?;
        rw [ h_support_card, List.toFinset_card_of_nodup ];
        · -- The length of the initial part [⟨4, by sorry⟩, ⟨5, by sorry⟩, ⟨1, by sorry⟩, ⟨2, by sorry⟩] is 4.
          simp [l3];
        · exact?;
      -- Apply the fact that the sign of a cycle is (-1) raised to the power of (length - 1).
      have h_sign_cycle : ∀ {σ : Equiv.Perm (Fin (N n k m))}, σ.IsCycle → (σ.support.card = m + 4) → (σ.sign : ℤ) = (-1) ^ (m + 3) := by
        -- Apply the lemma that states the sign of a cycle is (-1) raised to the power of (length - 1).
        intros σ hσ hcard
        rw [hσ.sign];
        norm_num [ hcard, pow_succ' ];
      exact h_sign_cycle this ( h_sign_g3 this )

/-
If H contains an odd permutation, then H is the symmetric group.
-/
lemma H_eq_top_of_odd (n k m : ℕ) (hn : 1 < n) (hk : 0 < k) (hm : 0 < m)
    (h_odd : ∃ g ∈ H n k m, Equiv.Perm.sign g = -1) : H n k m = ⊤ := by
      -- By Lemma `H_eq_alternating_or_top`, H is either the alternating group or the symmetric group.
      have h_cases : H n k m = alternatingGroup (Fin (N n k m)) ∨ H n k m = ⊤ := by
        exact?;
      aesop

/-
If n is even, H is the symmetric group.
-/
lemma H_eq_top_of_n_even (n k m : ℕ) (hn : 1 < n) (hk : 0 < k) (hm : 0 < m) (hn_even : Even n) :
    H n k m = ⊤ := by
      apply_rules [ H_eq_top_of_odd ];
      use g1 n k m;
      -- Since $n$ is even, $n + 3$ is odd, so $(-1)^{n + 3} = -1$.
      have h_sign : Equiv.Perm.sign (g1 n k m) = (-1 : ℤ) ^ (n + 3) := by
        -- Apply the lemma that states the sign of g1 is (-1)^(n+3).
        apply sign_g1 n k m (by linarith);
      norm_num [ hn_even, pow_add ] at h_sign ⊢ ; norm_cast at h_sign ⊢ ; aesop;
      · exact Subgroup.subset_closure ( Set.mem_insert _ _ );
      · -- Since the sign is an integer, we can conclude that the sign itself is -1.
        convert h_sign using 1;
        exact?

/-
If k is even, H is the symmetric group.
-/
lemma H_eq_top_of_k_even (n k m : ℕ) (hn : 1 < n) (hk : 0 < k) (hm : 0 < m) (hk_even : Even k) :
    H n k m = ⊤ := by
      -- Since $k$ is even, $k+3$ is odd, so the sign of $g2$ is $-1$.
      have h_sign_g2 : Equiv.Perm.sign (g2 n k m) = -1 := by
        -- Since $k$ is even, $k+3$ is odd, so $(-1)^{k+3} = -1$.
        have h_sign_g2 : Equiv.Perm.sign (g2 n k m) = (-1 : ℤ) ^ (k + 3) := by
          exact?;
        norm_num [ hk_even, pow_add ] at h_sign_g2 ; aesop;
      apply H_eq_top_of_odd n k m hn hk hm;
      exact ⟨ _, Subgroup.subset_closure <| Set.mem_insert_of_mem _ <| Set.mem_insert _ _, h_sign_g2 ⟩

/-
If m is even, H is the symmetric group.
-/
lemma H_eq_top_of_m_even (n k m : ℕ) (hn : 1 < n) (hk : 0 < k) (hm : 0 < m) (hm_even : Even m) :
    H n k m = ⊤ := by
      convert H_eq_top_of_odd n k m hn hk hm ⟨ g3 n k m, Subgroup.subset_closure ( by norm_num ), ?_ ⟩;
      have := sign_g3 n k m hm;
      norm_num [ hm_even, pow_add ] at this;
      erw [ Equiv.Perm.sign ] ; aesop

/-
If at least one of n, k, m is even, then H is the symmetric group.
-/
theorem H_eq_top_of_exists_even (n k m : ℕ) (hn : 1 < n) (hk : 0 < k) (hm : 0 < m)
    (h_even : Even n ∨ Even k ∨ Even m) : H n k m = ⊤ := by
      rcases h_even with ( h | h | h ) <;> [ exact H_eq_top_of_n_even n k m hn hk hm h; exact H_eq_top_of_k_even n k m hn hk hm h; exact H_eq_top_of_m_even n k m hn hk hm h ]

/-
If n, k, m are all odd, H is the alternating group.
-/
lemma H_eq_alternating_of_all_odd (n k m : ℕ) (hn : 1 < n) (hk : 0 < k) (hm : 0 < m)
    (hn_odd : Odd n) (hk_odd : Odd k) (hm_odd : Odd m) : H n k m = alternatingGroup (Fin (N n k m)) := by
      -- If n, k, m are all odd, then all generators of H are in the alternating group.
      have h_all_in_A : ∀ g ∈ ({g1 n k m, g2 n k m, g3 n k m} : Set (Perm (Fin (N n k m)))), Equiv.Perm.sign g = 1 := by
        intro g hg
        have h_sign_g : Equiv.Perm.sign g = (-1 : ℤ) ^ (n + 3) ∨ Equiv.Perm.sign g = (-1 : ℤ) ^ (k + 3) ∨ Equiv.Perm.sign g = (-1 : ℤ) ^ (m + 3) := by
          rcases hg with ( rfl | rfl | rfl ) <;> [ exact Or.inl <| mod_cast sign_g1 n k m <| by linarith; ; exact Or.inr <| Or.inl <| mod_cast sign_g2 n k m <| by linarith; ; exact Or.inr <| Or.inr <| mod_cast sign_g3 n k m <| by linarith ];
        rcases h_sign_g with h | h | h <;> norm_cast at h <;> simp_all +decide [ parity_simps ];
      refine' le_antisymm _ _;
      · exact fun g hg => Subgroup.closure_induction ( fun x hx => by aesop ) ( by aesop ) ( by aesop ) ( by aesop ) hg;
      · apply_rules [ alternatingGroup_le_H ]

/-
H is the symmetric group iff at least one of n, k, m is even.
-/
theorem H_eq_top_iff (n k m : ℕ) (hn : 1 < n) (hk : 0 < k) (hm : 0 < m) :
    H n k m = ⊤ ↔ (Even n ∨ Even k ∨ Even m) := by
      apply Iff.intro;
      · contrapose!;
        -- If n, k, m are all odd, then H n k m is equal to the alternating group.
        intro h_odd
        have h_alt : H n k m = alternatingGroup (Fin (N n k m)) := by
          exact H_eq_alternating_of_all_odd n k m hn hk hm ( by simpa using h_odd.1 ) ( by simpa using h_odd.2.1 ) ( by simpa using h_odd.2.2 );
        simp +decide [ h_alt, Subgroup.eq_top_iff' ];
        exact ⟨ Equiv.swap ⟨ 0, by linarith [ show N n k m > 0 from by { unfold N; linarith } ] ⟩ ⟨ 1, by linarith [ show N n k m > 1 from by { unfold N; linarith } ] ⟩, by simp +decide ⟩;
      · exact?